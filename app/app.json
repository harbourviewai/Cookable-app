{
  "expo": {
    "name": "Cookable",
    "slug": "cookable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cookable",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.harbourviewai.cookable",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cookable needs your camera to scan what's in your fridge.",
        "NSPhotoLibraryUsageDescription": "Cookable needs access to your photos so you can pick a fridge photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.harbourviewai.cookable",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Cookable needs your camera to scan what's in your fridge."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cookable needs access to your photos so you can pick a fridge photo."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
