# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Supabase (get from: https://supabase.com/dashboard → project → API settings)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Anthropic (get from: https://console.anthropic.com → API keys)
# IMPORTANT: this key MUST NOT live in app/.env.local — anything bundled into the
# Expo client is extractable. The plan is to call Anthropic from a Supabase Edge
# Function (see Day 8). Set this in the Edge Function's environment variables
# (Supabase Dashboard → Project Settings → Edge Functions → Secrets), not here.
# Listed in this file only as documentation of which key the project depends on.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# RevenueCat (get from: https://app.revenuecat.com → project → API keys)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_key_here

# PostHog (get from: https://app.posthog.com → project settings)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# AdMob (get from: https://admob.google.com → apps → ad units)
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=ca-app-pub-xxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=ca-app-pub-xxxxxxxx/xxxxxxxxxx
